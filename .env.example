# ---- Backend ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8100
DATABASE_URL=sqlite:///./data/app.db
SNAPSHOT_DIR=./data/snapshots
SECRET_KEY=change-me-to-a-random-string
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Shared token for backend internal ingestion endpoints. If set, detector calls
# include it automatically. Hikvision alarm URLs must include:
#   http://<server-ip>:8100/api/alarm?internal_token=<same-token>
INTERNAL_SERVICE_TOKEN=

# Shared password gate for the dashboard. Leave BLANK for MVP / local LAN use
# (no auth). Set to a long random string when you expose the dashboard beyond
# your office network — the password protects all /api/* endpoints + WebSocket.
DASHBOARD_PASSWORD=

# Comma-separated dashboard origins allowed to call the API. "*" supports
# localhost, LAN IP, and public-hostname access; authentication still requires
# a valid Bearer token.
CORS_ORIGINS=*

# Delete snapshot JPEGs under data/snapshots/ older than this many days.
# Set to 0 to keep everything forever.
SNAPSHOT_RETENTION_DAYS=30

# ---- MediaMTX (streaming server) ----
# WebRTC/HLS served at these ports; camera RTSP pulled by MediaMTX based on mediamtx.yml
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_HLS_PORT=8888
MEDIAMTX_API_PORT=9997

# ---- Remote access (outside the LAN) ----
# Set to the server's public IP/hostname so WebRTC advertises a reachable ICE
# candidate; then forward on the router: TCP 8889 (WebRTC), UDP 8189 (media),
# TCP 8100 (API). Leave blank for LAN-only. For strict/symmetric NAT you'll
# also need a TURN server (add it to webrtcICEServers2 in mediamtx/mediamtx.yml).
MEDIAMTX_PUBLIC_HOST=

# ---- Cameras ----
# Cameras are now managed through the dashboard (Cameras tab → "+ Add camera").
# The detector picks up additions/removals automatically — no service restart.
# There is no CAMERAS__* block here on purpose.

# ---- Face recognition (detector service) ----
# FACE_DET_SIZE: detector input size (square). 320 = fast/real-time on CPU;
#   raise to 640 to catch faces farther from the camera (~4x slower per frame).
# FACE_SAMPLE_FPS: frames analyzed per second per camera. The detector keeps
#   only the latest frame, so this is a true sampling rate (no backlog).
# FACE_MODEL: InsightFace pack — buffalo_l (accurate) or buffalo_s (faster).
FACE_DET_SIZE=320
FACE_SAMPLE_FPS=1.0
FACE_MODEL=buffalo_l

# When many AI cameras are enabled at once, start detector workers gradually
# instead of opening every RTSP stream in the same second.
CAMERA_WORKER_START_STAGGER_SEC=1.0
CAMERA_WORKER_START_STAGGER_MAX_SEC=30.0

# ---- YOLO detection ----
YOLO_MODEL=yolov8n.pt
YOLO_FPS=3
YOLO_CONFIDENCE=0.45
YOLO_CLASSES=person
# Ignore very small boxes. Cooldown defaults to 0 so the first matching frame
# after enabling a post option alerts immediately.
OBJECT_MIN_AREA=2500
OBJECT_ALERT_COOLDOWN_SEC=0
OBJECT_TRACK_FORGET_SEC=20
OBJECT_TRACK_MATCH_IOU=0.30
OBJECT_MOVE_REALERT_PX=120
OBJECT_MOVE_REALERT_RATIO=0.20

# ---- Alerts ----
# Email (leave SMTP_HOST blank to disable email alerts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@example.com
SMTP_TO=recipient@example.com
SMTP_USE_TLS=true

# Cooldown between email alerts for the same camera+class (seconds).
# Set to 0 for immediate email delivery on every stored event.
ALERT_COOLDOWN=0

# Guard/unknown event throttles. Defaults are immediate; raise these only if
# the event log becomes too noisy for your installation.
PRESENT_HEARTBEAT_SEC=0
UNKNOWN_ALERT_COOLDOWN_SEC=0

# ---- Frontend ----
# Leave blank: the dashboard auto-targets whatever host you open it on (localhost,
# LAN IP, or a port-forwarded address) on the conventional ports. Set explicit
# URLs only when running behind a reverse proxy / HTTPS on a different origin.
VITE_API_URL=
VITE_MEDIAMTX_URL=
